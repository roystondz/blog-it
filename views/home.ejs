<!DOCTYPE html>
<html lang="en">

<%- include('./partials/head') %>

<body class="bg-light">

    <%- include('./partials/navbar') %>

    <!-- Hero Section -->
    <section class="py-5 bg-white border-bottom">
        <div class="container text-center">
            <h1 class="display-5 fw-bold">Welcome to Blog It! 👋</h1>
            <p class="lead text-muted mb-0">
                Discover stories, ideas, and experiences from our community.
            </p>
        </div>
    </section>

    <!-- Blog Section -->
    <main class="container py-5">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1">Latest Blogs</h2>
                <p class="text-muted mb-0">Explore our latest posts</p>
            </div>
        </div>

        <% if (blogs && blogs.length > 0) { %>

            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

                <% blogs.forEach(blog => { %>

                    <div class="col">

                        <div class="card h-100 border-0 shadow-sm blog-card">

                            <!-- Cover Image -->
                            <img
                                src="<%= blog.coverImage %>"
                                class="card-img-top blog-image"
                                alt="<%= blog.title %>"
                            >

                            <div class="card-body d-flex flex-column">

                                <!-- Title -->
                                <h5 class="card-title fw-bold">
                                    <%= blog.title %>
                                </h5>

                                <!-- Description -->
                                <% if (blog.body) { %>
                                    <p class="card-text text-muted">
                                        <%= blog.body.length > 120
                                            ? blog.body.substring(0, 120) + '...'
                                            : blog.body
                                        %>
                                    </p>
                                <% } %>

                                <!-- Footer -->
                                <div class="mt-auto">

                                    <div class="d-flex justify-content-between align-items-center mb-3">

                                        <% if (blog.createdBy) { %>
                                            <small class="text-muted">
                                                By <%= blog.createdBy.fullName || blog.createdBy.name || 'Anonymous' %>
                                            </small>
                                        <% } %>

                                        <% if (blog.createdAt) { %>
                                            <small class="text-muted">
                                                <%= new Date(blog.createdAt).toLocaleDateString() %>
                                            </small>
                                        <% } %>

                                    </div>

                                    <a
                                        href="/blog/<%= blog._id %>"
                                        class="btn btn-primary w-100"
                                    >
                                        Read More →
                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>

                <% }) %>

            </div>

        <% } else { %>

            <!-- Empty State -->
            <div class="text-center py-5">

                <h4 class="fw-bold">No blogs yet</h4>

                <p class="text-muted">
                    There are no blog posts available right now.
                </p>

            </div>

        <% } %>

    </main>

    <%- include('./partials/scripts') %>

    <style>
        .blog-card {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            border-radius: 12px;
            overflow: hidden;
        }

        .blog-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12) !important;
        }

        .blog-image {
            height: 220px;
            object-fit: cover;
        }
    </style>

</body>
</html>
