<!DOCTYPE html>
<html lang="en">

<%- include('./partials/head') %>

<body class="bg-light">

    <%- include('./partials/navbar') %>

    <main class="container py-5">

        <!-- Blog Article -->
        <article class="bg-white rounded-3 shadow-sm p-4 p-md-5">

            <!-- Title -->
            <h1 class="display-5 fw-bold mb-3">
                <%= blog.title %>
            </h1>

            <!-- Author -->
            <div class="d-flex align-items-center mb-4 text-muted">

                <% if (blog.createdBy.profileImage) { %>

                    <img
                        src="<%= blog.createdBy.profileImage %>"
                        alt="Profile Picture"
                        class="rounded-circle me-2"
                        width="40"
                        height="40"
                        style="object-fit: cover;"
                    >

                <% } %>

                <div>
                    <small>Written by</small>
                    <div class="fw-semibold text-dark">
                        <%= blog.createdBy.fullName %>
                    </div>
                </div>

            </div>

            <!-- Cover Image -->
            <img
                src="<%= blog.coverImage %>"
                class="img-fluid rounded-3 mb-4 blog-cover"
                alt="<%= blog.title %>"
            >

            <!-- Blog Content -->
            <div class="blog-content mb-5">
                <%= blog.body %>
            </div>

            <hr class="my-5">

            <!-- Comments -->
            <section>

                <h4 class="fw-bold mb-4">
                    Comments (<%= locals.comments?.length || 0 %>)
                </h4>

                <% if (locals.comments?.length) { %>

                    <div class="comments">

                        <% locals.comments.forEach(comment => { %>

                            <div class="d-flex mb-4">

                                <!-- Comment Profile -->
                                <img
                                    src="<%= comment.createdBy.profileImage %>"
                                    alt="Profile Picture"
                                    class="rounded-circle me-3"
                                    width="40"
                                    height="40"
                                    style="object-fit: cover;"
                                >

                                <!-- Comment Content -->
                                <div class="bg-light rounded-3 px-3 py-2 flex-grow-1">

                                    <div class="fw-semibold">
                                        <%= comment.createdBy.fullName %>
                                    </div>

                                    <div class="text-muted">
                                        <%= comment.content %>
                                    </div>

                                </div>

                            </div>

                        <% }) %>

                    </div>

                <% } else { %>

                    <p class="text-muted">
                        No comments yet. Be the first to comment!
                    </p>

                <% } %>

            </section>


            <!-- Add Comment -->
            <% if (locals.user) { %>

                <section class="mt-5">

                    <h4 class="fw-bold mb-3">
                        Add a Comment
                    </h4>

                    <form
                        action="/comment/<%= blog._id %>"
                        method="POST"
                    >

                        <div class="mb-3">

                            <textarea
                                name="content"
                                class="form-control"
                                rows="4"
                                placeholder="Write your comment..."
                                required
                            ></textarea>

                        </div>

                        <button
                            type="submit"
                            class="btn btn-primary px-4"
                        >
                            Add Comment
                        </button>

                    </form>

                </section>

            <% } else { %>

                <div class="alert alert-light border mt-4">
                    Please log in to leave a comment.
                </div>

            <% } %>

        </article>

    </main>

    <%- include('./partials/scripts') %>

    <style>

        .blog-cover {
            width: 100%;
            max-height: 500px;
            object-fit: cover;
        }

        .blog-content {
            font-size: 1.1rem;
            line-height: 1.8;
            white-space: pre-wrap;
            color: #333;
        }

    </style>

</body>
</html>
